{
  "name": "vue-apollo-monorepo",
  "version": "5.0.0-alpha.2",
  "private": true,
  "packageManager": "pnpm@10.6.2+sha512.47870716bea1572b53df34ad8647b42962bc790ce2bf4562ba0f643237d7302a3d6a8ecef9e4bdfc01d23af1969aa90485d4cebb0b9638fa5ef1daef656f6c1b",
  "scripts": {
    "api:extract": "pnpm build && api-extractor run --local",
    "api:generate": "pnpm build && pnpm -C packages/docs api:generate",
    "build": "pnpm run -r --filter \"vue-apollo*\" --filter \"@vue/apollo*\" build",
    "docs:dev": "pnpm run -r --filter \"private-vue-apollo-docs\" dev",
    "docs:build": "pnpm run build && pnpm run -r --filter \"private-vue-apollo-docs\" build",
    "lint": "eslint . --cache",
    "release": "pnpm run build && pnpm run test && sheep release -b v5 --tag next",
    "test": "pnpm run -r --sequential test",
    "typecheck": "pnpm run -r --filter \"vue-apollo*\" --filter \"@vue/apollo*\" typecheck"
  },
  "devDependencies": {
    "@akryum/sheep": "catalog:",
    "@antfu/eslint-config": "catalog:",
    "@microsoft/api-extractor": "catalog:",
    "@microsoft/api-extractor-model": "catalog:",
    "@microsoft/tsdoc": "catalog:",
    "@parcel/watcher": "catalog:",
    "eslint": "catalog:",
    "jiti": "catalog:",
    "nodemon": "catalog:",
    "typescript": "catalog:"
  }
}
