{
  "name": "@vue/apollo-composable",
  "type": "module",
  "version": "5.0.0-alpha.2",
  "description": "Apollo GraphQL for Vue Composition API",
  "author": "Guillaume Chau <guillaume.b.chau@gmail.com>",
  "license": "MIT",
  "homepage": "https://apollo.vuejs.org/",
  "repository": {
    "type": "git",
    "url": "https://github.com/vuejs/vue-apollo.git",
    "directory": "packages/vue-apollo-composable"
  },
  "bugs": {
    "url": "https://github.com/vuejs/vue-apollo/issues"
  },
  "keywords": [
    "vue",
    "apollo",
    "graphql",
    "composition"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./compat": {
      "types": "./dist/compat.d.ts",
      "import": "./dist/compat.mjs",
      "require": "./dist/compat.cjs"
    }
  },
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "unbuild",
    "coverage": "vitest run --coverage",
    "dev": "pnpm nodemon -w ./src -e ts -x pnpm build",
    "prepublishOnly": "pnpm run test && pnpm run build",
    "test": "vitest run",
    "typecheck": "tsc --build"
  },
  "peerDependencies": {
    "@apollo/client": "^4.1.0",
    "@vue/reactivity": "^3.5.0",
    "@vue/runtime-core": "^3.5.0",
    "@vueuse/core": "^14.0.0",
    "@wry/equality": "^0.5.6",
    "rxjs": "^7.3.0"
  },
  "devDependencies": {
    "@graphql-yoga/plugin-defer-stream": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vue/runtime-dom": "catalog:",
    "@vue/server-renderer": "catalog:",
    "@vue/test-utils": "catalog:",
    "graphql": "catalog:",
    "graphql-sse": "catalog:",
    "graphql-tag": "catalog:",
    "graphql-yoga": "catalog:",
    "jsdom": "catalog:",
    "nodemon": "catalog:",
    "typescript": "catalog:",
    "unbuild": "catalog:",
    "vitest": "catalog:"
  }
}
